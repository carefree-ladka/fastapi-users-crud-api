# Application settings
# Copy this file to .env and adjust values as needed.

# Display name of the API (shown in OpenAPI docs).
APP_NAME=USERS CRUD APIs

# Semantic version of the app (shown in OpenAPI docs).
APP_VERSION=0.1.0

# Short description (shown in OpenAPI docs).
APP_DESCRIPTION=USERS CRUD APIs.

# Prefix that all v1 routes are mounted under.
# Set to an empty value to serve routes without a prefix (e.g. /users).
API_V1_PREFIX=/api/v1

# Database connection string (SQLAlchemy URL).
# Defaults to a local SQLite file. Examples:
#   sqlite:///./app.db
#   postgresql+psycopg://user:pass@localhost:5432/mydb
DATABASE_URL=sqlite:///./app.db

# --- Auth / security ---
# Secret used to sign JWTs. Generate a strong random value for production, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookie behaviour. Set COOKIE_SECURE=true when served over HTTPS.
# COOKIE_SAMESITE is one of: lax, strict, none (use "none" + secure for cross-site).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
